DASHSCOPE_API_KEY=
DASHSCOPE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_OPTIMIZED_MODEL=
DASHSCOPE_TIMEOUT_SECONDS=30
# 短剧文案分析/生成（拆段较慢，建议 90）
SHORT_DRAMA_SCRIPT_TIMEOUT_SECONDS=90
# 单段场景 AI 配图超时、并发段数（整次 /generate 可能 10～20 分钟）
SHORT_DRAMA_AI_MATERIAL_TIMEOUT_SECONDS=90
SHORT_DRAMA_AI_MATERIAL_PARALLEL=3
DASHSCOPE_TEMPERATURE=0.2
DASHSCOPE_MAX_TOKENS=512

RAG_DEFAULT_USER_ID=default_user
RAG_DEFAULT_WORKSPACE_ID=default_workspace
RAG_STORAGE_DIR=./data/rag_storage
RAG_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_tools
RAG_VECTOR_STORE_BACKEND=pgvector
RAG_FILE_STORAGE_BACKEND=local
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_DIM=128
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

ANALYTICS_DATABASE_URL=
ANALYTICS_IP_SALT=change-me

# 短剧素材库（留空=本地 JSON；勿与 RAG 远程库混用）
SHORT_DRAMA_DATABASE_URL=
# 启动时扫描 uploads 图片（本地开发建议 false）
SHORT_DRAMA_STARTUP_CLEANUP=false

# 本地多进程：生图/分镜长任务时其它接口仍可响应（reload=1 时无效，固定单进程）
UVICORN_WORKERS=2

# CosyVoice 配音（复用 DASHSCOPE_API_KEY；非流式 SpeechSynthesizer 接口）
TTS_MODEL=cosyvoice-v2
TTS_VOICE_DEFAULT=longxiaochun_v2
TTS_TIMEOUT_SECONDS=60

# 即梦 AI 动态素材生成（OpenAI 兼容图片接口）
JIMENG_API_KEY=
JIMENG_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
JIMENG_MODEL=doubao-seedream-4-0-250828
JIMENG_IMAGE_SIZE=1080x1920
JIMENG_TIMEOUT_SECONDS=120
